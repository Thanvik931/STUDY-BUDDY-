{
  "name": "study-buddy",
  "version": "1.0.0",
  "description": "Adaptive Study Companion with MongoDB Agentic Memory",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "node src/setupIndexes.js",
    "test": "node --test tests/**/*.test.js",
    "smoke": "node scripts/smoke.js",
    "evaluate": "node scripts/evaluate.js",
    "stress": "node scripts/stresstest.js",
    "stress:quick": "node scripts/stresstest.js --quick",
    "stress:soak": "node scripts/stresstest.js --soak",
    "stresstest": "node scripts/stresstest.js",
    "postinstall": "node scripts/copy-vendor.js",
    "check:env": "node scripts/check-env.js",
    "scan:secrets": "node scripts/scan-secrets.js",
    "check:exposed": "node scripts/check-exposed.js",
    "check:links": "node scripts/check-links.js",
    "check:copy": "node scripts/check-copy.js",
    "check:placeholders": "node scripts/check-placeholders.js",
    "build:seo": "node scripts/build-seo.js",
    "admin:create": "node scripts/admin-create.js",
    "admin:reset-password": "node scripts/admin-reset-password.js",
    "audit:all": "node scripts/audit-all.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "argon2": "^0.45.1",
    "chart.js": "^4.5.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongodb": "^6.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "autocannon": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
