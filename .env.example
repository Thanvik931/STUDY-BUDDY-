NODE_ENV=development
MONGODB_URI=
MONGODB_DB=study_buddy_db
ANTHROPIC_API_KEY=
EMBEDDING_API_KEY=
SESSION_SECRET=
SITE_URL=http://localhost:3000
CONTACT_EMAIL=support@example.com

# Server & Pooling
PORT=3000
MONGO_MAX_POOL=50

# Embedding & AI Models
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-sentence-embedding
EMBEDDING_DIMENSIONS=1536
AI_MODEL=claude-3-5-haiku-20241022

# Development / Testing Flags (must be false in production)
DEMO_MODE=false
STRESS_MODE=false
FAIL_EMBEDDING=false
FAIL_AI=false
DELAY_AI_MS=0
STRESS_TARGET=
STRESS_DB_TIER=Atlas M0

# Optional Launch Settings
ALLOWED_ORIGINS=
ADMIN_ROUTES_ENABLED=false
ANALYTICS_PROVIDER=none
ANALYTICS_SRC=
ANALYTICS_SITE_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
