# Study Buddy Environment Configuration

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=study_buddy_db

# AI API Key (Google Gemini or OpenAI)
# For Gemini: Get your free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) If using OpenAI instead of Gemini
OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=gemini
